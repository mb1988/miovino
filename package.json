{
  "name": "miovino",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "deploy:preview": "cross-env CLOUDFLARE_ENV=preview vite build && wrangler deploy",
    "cf:setup": "node scripts/cf-setup.mjs",
    "db:migrate:local": "wrangler d1 migrations apply miovino --local",
    "db:query": "wrangler d1 execute miovino --remote --command",
    "cf:types": "wrangler types",
    "auth:invite": "node scripts/auth-invite.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "barcode-detector": "^3.2.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.62.3",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=22"
  }
}
