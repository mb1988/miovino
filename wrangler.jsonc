{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miovino",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Monthly drinking reminder: 1st of the month, 08:00 UTC.
  "triggers": { "crons": ["0 8 1 * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "miovino", "database_id": "758175e6-7bb3-43f9-97fa-e7fbbf298957", "migrations_dir": "migrations" }],
  // Only used with the optional Cloudflare Access login: set ACCESS_* and ALLOWED_EMAILS (comma-separated) in the dashboard or with wrangler secret put.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": "",
    // AI: free Gemini first, then OpenRouter free models, then Claude — whichever has a key (Worker secrets).
    "GEMINI_MODEL": "gemini-flash-latest",
    "OPENROUTER_MODEL": "openrouter/free"
  },
  "env": {
    // Preview deployments for pull requests: separate database and bucket, never touches real data.
    "preview": {
      "name": "miovino-preview",
      "d1_databases": [{ "binding": "DB", "database_name": "miovino-preview", "database_id": "c7951831-48f4-45c5-8b0c-6711b47f4133", "migrations_dir": "migrations" }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ALLOWED_EMAILS": "",
        "GEMINI_MODEL": "gemini-flash-lite-latest",
        "OPENROUTER_MODEL": "openrouter/free"
      }
    }
  }
}
