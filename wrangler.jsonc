{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miovino",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // IDs are filled in by `npm run cf:setup` (scripts/cf-setup.mjs) after `wrangler login`.
  "d1_databases": [{ "binding": "DB", "database_name": "miovino", "database_id": "local", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "miovino-photos" }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": "m.borry.j@gmail.com",
    "SCAN_MODEL": "claude-opus-5-5"
  },
  "env": {
    // Preview deployments for pull requests: separate database and bucket, never touches real data.
    "preview": {
      "name": "miovino-preview",
      "d1_databases": [{ "binding": "DB", "database_name": "miovino-preview", "database_id": "local-preview", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "miovino-photos-preview" }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ALLOWED_EMAILS": "m.borry.j@gmail.com",
        "SCAN_MODEL": "claude-haiku-4-5"
      }
    }
  }
}
